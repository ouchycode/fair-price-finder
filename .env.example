# Root environment file untuk docker-compose
# Salin file ini menjadi .env lalu isi nilainya.

# AI Engine (FastAPI)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Backend (CORS origin untuk frontend)
# Ganti dengan URL Vercel-mu, contoh: https://fair-price-finder.vercel.app
# Gunakan * untuk mengizinkan semua origin (khusus development)
FRONTEND_URL=*
